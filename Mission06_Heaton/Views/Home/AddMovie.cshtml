@{
    ViewData["Title"] = "Add Movie";
}

<h2 class="mb-4">Add Movie to Collection</h2>

<form method="post">

    <!-- Category (Required) -->
    <div class="mb-3">
        <label class="form-label">Category</label>
        <input type="text" name="Category" class="form-control" required />
    </div>

    <!-- Title (Required) -->
    <div class="mb-3">
        <label class="form-label">Title</label>
        <input type="text" name="Title" class="form-control" required />
    </div>

    <!-- Year (Required) -->
    <div class="mb-3">
        <label class="form-label">Year</label>
        <input type="number" name="Year" class="form-control" required />
    </div>

    <!-- Director (Required) -->
    <div class="mb-3">
        <label class="form-label">Director First Name</label>
        <input type="text" name="DirFirstName" class="form-control" required />
    </div>
    
    <div class="mb-3">
        <label class="form-label">Director Last Name</label>
        <input type="text" name="DirLastName" class="form-control" required />
    </div>

    <!-- Rating Dropdown (Required) -->
    <div class="mb-3">
        <label class="form-label">Rating</label>
        <select name="Rating" class="form-select" required>
            <option value="">Select Rating</option>
            <option>G</option>
            <option>PG</option>
            <option>PG-13</option>
            <option>R</option>
        </select>
    </div>

    <!-- Edited Yes/No (NOT Required) -->
    <div class="mb-3">
        <label class="form-label">Edited</label>
        <select name="Edited" class="form-select">
            <option value="">Select Option</option>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <!-- Lent To (NOT Required) -->
    <div class="mb-3">
        <label class="form-label">Lent To</label>
        <input type="text" name="LentTo" class="form-control" />
    </div>

    <!-- Notes (NOT Required, Max 25 chars) -->
    <div class="mb-3">
        <label class="form-label">Notes</label>
        <input type="text" name="Notes" class="form-control" maxlength="25" />
        <div class="form-text">Max 25 characters</div>
    </div>

    <button type="submit" class="btn btn-primary">Add Movie</button>

</form>