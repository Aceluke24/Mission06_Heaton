@model Movie
@{
    ViewData["Title"] = "Add Movie";
}


@* Used to Add/Edit a movie *@

<div class="container mt-5">
    <div class="card shadow-lg border-0">

        <!-- Colored Header -->
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Add Movie to Collection</h3>
        </div>

        <div class="card-body bg-light">

            <form method="post" asp-action="@(Model.MovieId == 0 ? "AddMovie" : "EditMovie")">
                <input type="hidden" asp-for="MovieId" />

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success">
                        @ViewBag.Message
                    </div>
                }

                <!-- MOVIE INFO -->
                <h5 class="text-primary mb-3">Movie Information</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">Select Category</option>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        </select>
                    </div>


                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Title</label>
                        <input type="text" asp-for="Title" class="form-control" required/>
                    </div>
                </div>


                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Year</label>
                        <input type="number" asp-for="Year" class="form-control" required/>
                        <div class="form-text">Must be 1888 or later</div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Director Name</label>
                        <input type="text" asp-for="Director" class="form-control" required/>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Rating</label>
                        <select asp-for="Rating" class="form-select" required>
                            <option value="">Select Rating</option>
                            <option>G</option>
                            <option>PG</option>
                            <option>PG-13</option>
                            <option>R</option>
                        </select>
                    </div>
                </div>

                <hr class="my-4"/>

                <!-- DETAILS -->
                <h5 class="text-success mb-3">Details</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Edited</label>
                        <select asp-for="Edited" class="form-select">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Copied To Plex</label>
                        <select asp-for="CopiedToPlex" class="form-select">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                </div>

                <hr class="my-4"/>

                <!-- Optional Fields -->
                <h5 class="text-secondary mb-3">Optional Information</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Lent To <span class="text-muted">(Optional)</span>
                        </label>
                        <input type="text" asp-for="LentTo" class="form-control"/>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Notes <span class="text-muted">(Optional)</span>
                        </label>
                        <input type="text" asp-for="Notes" class="form-control" maxlength="25"/>
                        <div class="form-text">Max 25 characters</div>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        Add Movie
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
