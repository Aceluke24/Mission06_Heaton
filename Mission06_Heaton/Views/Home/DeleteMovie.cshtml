@model Mission06_Heaton.Models.Movie

<h2>Delete Movie</h2>

<p>Are you sure you want to delete "<strong>@Model.Title</strong>"?</p>

<form asp-action="DeleteMovieConfirmed" method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="MovieList" class="btn btn-secondary">Cancel</a>
</form>